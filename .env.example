# ============================================================
# Copie para .env.local (dev) e configure na Vercel (produção).
# NUNCA commite valores reais. NUNCA cole estes valores no chat.
# ============================================================

# --- Anthropic (Claude Haiku) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5

# --- WhatsApp Cloud API (Meta oficial) ---
WHATSAPP_TOKEN=                 # token de System User (permanente), não o temporário de 24h
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_APP_SECRET=            # usado para validar assinatura X-Hub-Signature-256
WHATSAPP_VERIFY_TOKEN=          # string aleatória que você escolhe e repete no painel da Meta
META_GRAPH_VERSION=v24.0        # confirme a versão vigente no developers.facebook.com

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=      # somente servidor — nunca expor no navegador

# --- Segurança ---
CRON_SECRET=                    # a Vercel envia "Authorization: Bearer <CRON_SECRET>" nos crons
APP_URL=http://localhost:3000
